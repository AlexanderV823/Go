{
    "info": {
        "name": "Tasks API - Финальные автотесты",
        "schema": "https://getpostman.com"
    },
    "item": [
        {
            "name": "0. Проверка Health и Ошибка 405",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус-код должен быть 405', function () { pm.response.to.have.status(405); });",
                            "pm.test('Наличие заголовка Allow: GET', function () { pm.response.to.have.header('Allow', 'GET'); });",
                            "pm.test('Формат ошибки в JSON', function () { var jsonData = pm.response.json(); pm.expect(jsonData).to.have.property('error'); });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/health",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "health"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "1. Создание задачи (Успех и Нормализация пробелов)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус-код 201 Created', function () { pm.response.to.have.status(201); });",
                            "pm.test('Проверка автоматической очистки пробелов в title', function () { var jsonData = pm.response.json(); pm.expect(jsonData).to.have.property('id'); pm.expect(jsonData.title).to.eql('Забрать заказ из Озона'); pm.expect(jsonData.done).to.eql(false); pm.collectionVariables.set('currentTaskId', jsonData.id); });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"   Забрать заказ из Озона   \"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/tasks",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "tasks"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "2. Получение списка (Проверка стабильного порядка по ID)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус-код 200 OK', function () { pm.response.to.have.status(200); });",
                            "pm.test('Ответ является массивом JSON', function () { var jsonData = pm.response.json(); pm.expect(jsonData).to.be.an('array'); pm.expect(jsonData.length).to.be.above(0); });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/tasks",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "tasks"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "3. Получение созданной задачи по ID",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус-код 200 OK', function () { pm.response.to.have.status(200); });",
                            "pm.test('ID в ответе соответствует сохраненному значению', function () { var jsonData = pm.response.json(); pm.expect(jsonData.id).to.eql(Number(pm.collectionVariables.get('currentTaskId'))); pm.expect(jsonData.title).to.eql('Забрать заказ из Ожного'); });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/tasks/{{currentTaskId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "tasks",
                        "{{currentTaskId}}"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "4. Проверка Ошибки 405 для элемента",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус-код 405 Method Not Allowed', function () { pm.response.to.have.status(405); });",
                            "pm.test('Проверка заголовка Allow для элемента', function () { pm.response.to.have.header('Allow', 'GET, PUT, DELETE'); });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/tasks/{{currentTaskId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "tasks",
                        "{{currentTaskId}}"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "5. Полное обновление задачи (PUT)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус-код 200 OK', function () { pm.response.to.have.status(200); });",
                            "pm.test('Поля успешно обновлены и нормализованы', function () { var jsonData = pm.response.json(); pm.expect(jsonData.title).to.eql('Забрать посылку из Озона'); pm.expect(jsonData.done).to.eql(true); });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"   Забрать посылку из Озона   \",\n    \"done\": true\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/tasks/{{currentTaskId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "tasks",
                        "{{currentTaskId}}"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "6. Удаление задачи (Проверка 204 No Content)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус-код 204 No Content', function () { pm.response.to.have.status(204); });",
                            "pm.test('Тело ответа должно отсутствовать', function () { pm.expect(pm.response.text()).to.be.empty; });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/tasks/{{currentTaskId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "tasks",
                        "{{currentTaskId}}"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "7. Повторное удаление (Проверка Доменной Ошибки 404)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус-код 404 Not Found', function () { pm.response.to.have.status(404); });",
                            "pm.test('Формат ошибки содержит поле error', function () { var jsonData = pm.response.json(); pm.expect(jsonData).to.have.property('error', 'Задача не найдена'); });"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/tasks/{{currentTaskId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "tasks",
                        "{{currentTaskId}}"
                    ]
                }
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string"
        },
        {
            "key": "currentTaskId",
            "value": "",
            "type": "string"
        }
    ]
}